# ---------------- 构建产物 ----------------
# 注意：build/ 是打包脚本目录，**必须入库**；PyInstaller 的中间产物都丢在 .build/
# 回归检查（oauth_mode_check / no_popup_check）的结果也写在 .build/ 里
.build/
dist/
*.spec

# ---------------- 运行时产物（含密钥，绝对不要提交）----------------
# config.json 里存有企业微信 / 钉钉的真实 key，必须挡在版本库外
config.json
checkin.log
selftest.json
*.log

# 账号直连模式的令牌（明文 accessToken / refreshToken，绝不能提交）
auth_oauth.json
auth_oauth.json.tmp

# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/

# ---------------- 编辑器 / 系统 ----------------
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
desktop.ini

# ---------------- 本地工具状态 ----------------
# 内含本机路径、进程号、账号 uid 等个人环境信息，不适合公开
.workbuddy/
